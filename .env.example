# Settings for the assistant: copy to .env and fill in. Never commit the real .env.

# --- Django ---

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# True only for local development
DJANGO_DEBUG=False
# Hosts the API answers on, comma separated. In production: api.nestorbracho.com (docs/adr/0005-…)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins whose pages may call the API (CORS), comma separated. In production: https://nestorbracho.com
CORS_ALLOWED_ORIGINS=http://localhost:8000

# --- Data ---

# PostgreSQL with the pgvector extension: conversations, messages, leads and the knowledge base embeddings
DATABASE_URL=postgres://assistant@localhost:5432/assistant
# Redis for the answer and embedding caches
REDIS_URL=redis://localhost:6379/0

# --- Claude API ---

# From the Anthropic Console (console.anthropic.com)
ANTHROPIC_API_KEY=
# The router sends simple questions to the cheaper model and complex ones to the stronger model
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
ANTHROPIC_MODEL_STRONG=claude-sonnet-5-5
# Monthly spending cap in euros. Once reached, only the cheaper model answers, then a static reply with the
# contact form
ANTHROPIC_MONTHLY_BUDGET_EUR=10

# --- Observability (Langfuse) ---

# From the project settings of the Langfuse instance
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The self-hosted Langfuse instance, e.g. http://localhost:3000
LANGFUSE_HOST=http://localhost:3000

# --- Leads ---

# Where the create_contact_request tool sends each new lead. Empty: leads are only stored
LEADS_NOTIFY_EMAIL=
